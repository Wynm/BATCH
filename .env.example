# BATCH Gateway Configuration
HOST=0.0.0.0
PORT=20128
DATA_DIR=./data

# Encryption master key (64 hex chars / 32 bytes). Auto-generated into DATA_DIR/.batch-master.key if omitted.
# BATCH_MASTER_KEY=

# Optional gateway bearer token to protect /v1/* and /api/* when exposed publicly
# BATCH_API_KEY=

# Enable built-in local simulator provider for testing without external keys (true/false)
BATCH_ENABLE_DEMO_PROVIDER=true

# Optional auto-imported official provider keys (single user key per provider)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# HF_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
